# Variables de entorno para Maintena
# Copiar este archivo a .env y ajustar valores

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maintena_db
DB_USER=root
DB_PASSWORD=root

# JWT (se configurará en Fase 2)
JWT_SECRET=change_this_secret_in_production_use_a_long_secure_random_string
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
