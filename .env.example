# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maintena_db
DB_USER=root
DB_PASSWORD=root

# Servidor
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT
JWT_SECRET=change_this_to_a_long_random_base64_secret
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# Bloqueo por intentos fallidos de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Correo (Mailpit en Docker: UI en http://localhost:8025)
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@maintena.local
APP_FRONTEND_URL=http://localhost:8081

# Recuperación de contraseña
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_COOLDOWN=60

# Adjuntos de órdenes (imágenes y PDF)
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_SIZE=5MB
ATTACHMENT_MAX_REQUEST=6MB

# Docker Compose
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=maintena_db
MYSQL_USER=maintena_user
MYSQL_PASSWORD=maintena_pass
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
